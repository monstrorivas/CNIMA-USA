# Copy this file to .env (already in .gitignore - it will never be
# committed) and fill in real values for local testing with `netlify dev`.

# Stripe -> Developers -> API keys in the Stripe dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal -> developer.paypal.com -> Apps & Credentials
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
# "sandbox" while testing, "live" once these are real production credentials
PAYPAL_MODE=sandbox

# Registration -> Google Sheets export, pushed in real time via Netlify's
# outgoing form webhook (netlify/functions/handle-registration-webhook.js) -
# no Netlify API token needed, just a secret only you and Netlify know.
# Generate your own, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
REGISTRATION_WEBHOOK_SECRET=83dce3e3f5fa7601d1e5e25d4940e309ee163d3ea6b06690
# Google Cloud service account (share the target Sheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
# Keep the \n sequences literal (not real newlines) - the code un-escapes them
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long ID in the sheet's URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=...

# "Payment confirmed" email - fires exactly once, instantly, only when a
# registrant's payment actually completes (Stripe or PayPal), never on form
# submission alone. resend.com -> API Keys -> Create API Key.
RESEND_API_KEY=re_...
# Must be on a domain you've verified with Resend (dashboard -> Domains) -
# sending from an unverified domain only works to your own Resend account
# email, not to real registrants, until verification (a few DNS records) is
# done. Format can be a bare address or "Display Name <address>".
RESEND_FROM_EMAIL=CNIMA USA <noreply@cnimausa.com>

# Copy this file to .env (already in .gitignore - it will never be
# committed) and fill in real values for local testing with `netlify dev`.

# Stripe -> Developers -> API keys in the Stripe dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe -> Developers -> Webhooks -> your endpoint
# (https://<site>/.netlify/functions/stripe-webhook, event
# checkout.session.completed) -> "Signing secret". Test mode and live mode
# endpoints each have their own secret. For local testing, `stripe listen
# --forward-to localhost:8888/.netlify/functions/stripe-webhook` prints one.
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal -> developer.paypal.com -> Apps & Credentials
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
# "sandbox" while testing, "live" once these are real production credentials
PAYPAL_MODE=sandbox

# Registration -> Google Sheets export, pushed in real time via Netlify's
# outgoing form webhook (netlify/functions/handle-registration-webhook.js) -
# no Netlify API token needed, just a secret only you and Netlify know.
# Generate your own, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
REGISTRATION_WEBHOOK_SECRET=83dce3e3f5fa7601d1e5e25d4940e309ee163d3ea6b06690
# Google Cloud service account (share the target Sheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
# Keep the \n sequences literal (not real newlines) - the code un-escapes them
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long ID in the sheet's URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=...
# Optional second spreadsheet for the people running each week: it needs
# two tabs named exactly "Week 1" and "Week 2", shared with the same service
# account as Editor. Registrants get a row in the tab(s) for their week(s),
# updated when they pay. Editors can freely rename columns, recolor and add
# columns; leave unset to skip it.
GOOGLE_WEEKS_SHEET_ID=...

# Signs the personal "pay your balance" links emailed after a $200 deposit.
# Any long random string, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Changing it invalidates every link already sent (registrants can get a
# fresh one from the "Find my registration" box on /pay-balance.html).
BALANCE_LINK_SECRET=...

# Payment emails (deposit receipt with the balance link, or the full
# confirmation) fire exactly once, instantly, only when a registrant's
# payment actually completes (Stripe or PayPal), never on form submission
# alone. Balance reminders and re-sent links use the same key.
# resend.com -> API Keys -> Create API Key.
RESEND_API_KEY=re_...
# Must be on a domain you've verified with Resend (dashboard -> Domains) -
# sending from an unverified domain only works to your own Resend account
# email, not to real registrants, until verification (a few DNS records) is
# done. Format can be a bare address or "Display Name <address>".
RESEND_FROM_EMAIL=CNIMA USA <noreply@cnimausa.com>

# Admin-only payment setup check (/admin-test.html -> netlify/functions/admin-check.js
# and friends; see docs/admin-check.md). The page and its functions are disabled
# entirely while this is unset. Generate your own, e.g.
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
# and set it in Netlify (Site settings -> Environment variables). You type it
# into the page; it is sent in a request header, never in the URL.
ADMIN_CHECK_SECRET=
